# PipeWire as the audio server, replacing PulseAudio. rtkit lets it manage
# real-time scheduling.
{ ... }:

{
  services.pulseaudio.enable = false;
  security.rtkit.enable = true;
  services.pipewire = {
    enable = true;
    alsa.enable = true;
    alsa.support32Bit = true;
    pulse.enable = true;
  };
}
